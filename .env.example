# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3141
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/<dbname>

# ─── Authentication ───────────────────────────────────────────────────────────
# Change these to long random strings in production (use: openssl rand -hex 32)
JWT_TEACHER_PASSWORD=your_teacher_jwt_secret_here
JWT_STUDENT_PASSWORD=your_student_jwt_secret_here

# ─── Gemini AI ────────────────────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ─── Pinecone Vector DB ───────────────────────────────────────────────────────
# Required for RAG (Retrieval Augmented Generation) — comment out to use in-memory fallback
PINECONE_API_KEY=your_pinecone_api_key_here
# PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX_NAME=quiz-knowledge

# ─── Redis Cache ──────────────────────────────────────────────────────────────
# Leave empty to use the in-memory fallback (no Redis needed for local dev)
REDIS_URL=redis://localhost:6379

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Use * to allow all (development only — never in production)
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-domain.vercel.app

# ─── Logging ─────────────────────────────────────────────────────────────────
# Options: error, warn, info, debug
LOG_LEVEL=info
