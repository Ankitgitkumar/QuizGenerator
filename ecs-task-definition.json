{
  "family": "quizforge-backend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::YOUR_ACCOUNT_ID:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::YOUR_ACCOUNT_ID:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "quizforge-backend",
      "image": "YOUR_ACCOUNT_ID.dkr.ecr.YOUR_REGION.amazonaws.com/quizforge:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3141,
          "hostPort": 3141,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "NODE_ENV",                "value": "production" },
        { "name": "PORT",                    "value": "3141" },
        { "name": "GEMINI_MODEL",            "value": "gemini-2.5-flash" },
        { "name": "GEMINI_EMBEDDING_MODEL",  "value": "gemini-embedding-001" },
        { "name": "PINECONE_INDEX_NAME",     "value": "quiz-knowledge" },
        { "name": "LOG_LEVEL",              "value": "info" },
        { "name": "ALLOWED_ORIGINS",         "value": "https://YOUR_FRONTEND_DOMAIN" }
      ],
      "secrets": [
        {
          "name": "MONGODB_URI",
          "valueFrom": "arn:aws:ssm:YOUR_REGION:YOUR_ACCOUNT_ID:parameter/quizforge/MONGODB_URI"
        },
        {
          "name": "JWT_TEACHER_PASSWORD",
          "valueFrom": "arn:aws:ssm:YOUR_REGION:YOUR_ACCOUNT_ID:parameter/quizforge/JWT_TEACHER_PASSWORD"
        },
        {
          "name": "JWT_STUDENT_PASSWORD",
          "valueFrom": "arn:aws:ssm:YOUR_REGION:YOUR_ACCOUNT_ID:parameter/quizforge/JWT_STUDENT_PASSWORD"
        },
        {
          "name": "GEMINI_API_KEY",
          "valueFrom": "arn:aws:ssm:YOUR_REGION:YOUR_ACCOUNT_ID:parameter/quizforge/GEMINI_API_KEY"
        },
        {
          "name": "PINECONE_API_KEY",
          "valueFrom": "arn:aws:ssm:YOUR_REGION:YOUR_ACCOUNT_ID:parameter/quizforge/PINECONE_API_KEY"
        },
        {
          "name": "REDIS_URL",
          "valueFrom": "arn:aws:ssm:YOUR_REGION:YOUR_ACCOUNT_ID:parameter/quizforge/REDIS_URL"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/quizforge-backend",
          "awslogs-region": "YOUR_REGION",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "wget -qO- http://localhost:3141/health || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 10
      }
    }
  ]
}
